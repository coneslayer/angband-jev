# Copy to .env and adjust. All values are optional.

# --- Kev server ---
# Hugging Face Hub id, Hub revision (id@rev), or local checkpoint dir.
# Kev-4B (jaredpalmer/kev-4b) needs ~16 GB of free GPU memory.
KEV_RUN=jaredpalmer/kev-0.8b
# auto | cpu | cuda
KEV_DEVICE=cuda
# bf16 | fp32
KEV_DTYPE=bf16
# Set to require "Authorization: Bearer <key>" on /v1/*. busho reuses it.
KEV_API_KEY=

# --- Game ---
SEED=42

# --- busho player decision backend ---
# systemone (Kev/Jev) | ollama | anthropic
LLM_BACKEND=systemone
SYSTEMONE_URL=http://kev:8009
SYSTEMONE_MODEL=kev-latest
SYSTEMONE_API_KEY=
# Below this confidence (0..1) a decision is ignored and the rules decide.
DECISION_MIN_CONFIDENCE=0.3

# Hosted Jev instead of local Kev:
# SYSTEMONE_URL=https://api.typesafe.ai
# SYSTEMONE_MODEL=jev-latest
# SYSTEMONE_API_KEY=<your TypeSafe API key>
